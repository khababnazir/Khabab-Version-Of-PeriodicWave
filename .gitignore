# --- run outputs ---
# Kept in git since 2026-10-29 as the backup of every result: checkpoints,
# training curves, figures.  Each file is small (the largest about 22 MB;
# GitHub refuses files over 100 MB).  Only the lock files stay out: they are
# empty and only matter while a job runs.
*.lock
*.tmp

# --- python ---
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.ipynb_checkpoints/

# --- editor / local ---
.vscode/
.idea/
.env
