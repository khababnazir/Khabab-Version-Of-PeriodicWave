+# ADDED IN THIS COPY: the two functions that make the twist.
+
+def twist_vector(G, twist_1, twist_2):
+    """k_twist = twist_1 G1 + twist_2 G2, with G1, G2 the rows of G (the supercell's
+    reciprocal vectors).  Then k_twist . L_i = 2 pi twist_i."""
+    G = np.asarray(G, dtype=np.float64)
+    return twist_1 * G[0] + twist_2 * G[1]
+
+
+def add_twist(psi, R, k_twist):
+    """Multiply the wave function by exp(i k_twist . (r_1 + ... + r_N)).
+    psi is a LogPsi (log_abs, phase) and R has shape (N, 2): only the phase changes."""
+    import jax.numpy as jnp
+    return psi._replace(phase=psi.phase + jnp.sum(R @ jnp.asarray(k_twist, dtype=R.dtype)))
+
+
